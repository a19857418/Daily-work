# 複製這個檔案為 .env 後再修改
PORT=4000

# JWT 簽章密鑰，務必換成一組長且隨機的字串（例如：openssl rand -base64 48）
JWT_SECRET=change-me-to-a-long-random-secret
# JWT 有效期限
TOKEN_TTL=12h

# 允許呼叫此 API 的前端來源，多個網址用逗號分隔；內部工具可先用 * 開放全部
ALLOWED_ORIGIN=*

# ---------------------------------------------------------
# 資料庫連線：三選一
# ---------------------------------------------------------

# 方式 1：本機開發，完整連線字串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_settings

# 方式 2：部署到 GCP Cloud Run，透過 Cloud SQL 連接器掛載的 unix socket
# （設定這個之後不要再設定 DATABASE_URL；DB_USER/DB_PASSWORD/DB_NAME 仍需要）
# INSTANCE_UNIX_SOCKET=/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE
# DB_USER=app_user
# DB_PASSWORD=change-me
# DB_NAME=shop_settings

# 方式 3：一般 TCP 連線（例如透過 Cloud SQL Auth Proxy 監聽本機）
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=app_user
# DB_PASSWORD=change-me
# DB_NAME=shop_settings
